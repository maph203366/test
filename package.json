{
  "name": "mobile-calculator-app",
  "version": "1.0.0",
  "description": "A responsive mobile calculator app.",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync:android": "npm run build:web && cap sync android",
    "build:android": "npm run sync:android && cd android && ./gradlew assembleDebug",
    "test": "node --test"
  },
  "keywords": [
    "calculator",
    "mobile",
    "pwa"
  ],
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1"
  }
}
